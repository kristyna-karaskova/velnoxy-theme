{% comment %}
  Safety net for the Velnoxy look.
  Rendered in layout/theme.liquid BEFORE Dawn's own {% style %} block, so whenever the
  theme settings exist (fonts + color schemes from Theme settings), they override these
  values. If the settings are missing (e.g. settings_data.json was not accepted on upload),
  the store still renders in DM Sans with the Velnoxy color schemes instead of browser
  defaults (Times + white).
{% endcomment %}
{%- if settings.type_body_font.family == blank or settings.type_header_font.family == blank -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap"
    rel="stylesheet"
  >
{%- endif -%}
<style>
