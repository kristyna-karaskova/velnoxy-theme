<section
  id="{% if section.settings.anchor != blank %}{{ section.settings.anchor | handleize }}{% else %}vx-{{ section.id }}{% endif %}"
  class="vx-section vx-section--comparison color-{{ section.settings.color_scheme }} gradient"
  style="--vx-pt: {{ section.settings.padding_top }}px; --vx-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="vx-wrap vx-wrap--narrow">
    {% render 'vx-heading', s: section.settings %}
    <div class="vx-table-wrap">
      <table class="vx-table">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">{{ section.settings.feature_label }}</span></th>
            <th scope="col" class="is-us">{{ section.settings.col_a }}</th>
            <th scope="col">{{ section.settings.col_b }}</th>
            <th scope="col">{{ section.settings.col_c }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              {%- assign cells = block.settings.a | append: '||' | append: block.settings.b | append: '||' | append: block.settings.c | split: '||' -%}
              {%- for cell in cells -%}
                {%- assign c = cell | strip -%}
                <td{% if forloop.first %} class="is-us"{% endif %}>
                  {%- if c == 'yes' -%}
                    <span class="vx-mark vx-mark--yes">{% render 'vx-icon', icon: 'check', icon_size: 14 %}</span><span class="visually-hidden">Yes</span>
                  {%- elsif c == 'no' -%}
                    <span class="vx-mark vx-mark--no">{% render 'vx-icon', icon: 'cross', icon_size: 14 %}</span><span class="visually-hidden">No</span>
                  {%- else -%}
                    {{ c }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
