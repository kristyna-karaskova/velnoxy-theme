<section
  id="{% if section.settings.anchor != blank %}{{ section.settings.anchor | handleize }}{% else %}vx-{{ section.id }}{% endif %}"
  class="vx-section vx-section--trust-strip color-{{ section.settings.color_scheme }} gradient"
  style="--vx-pt: {{ section.settings.padding_top }}px; --vx-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="vx-wrap">
    <ul class="vx-trust-strip list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>{% render 'vx-icon', icon: block.settings.icon, icon_size: 20 %}<span>{{ block.settings.text }}</span></li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "VX · Trust strip",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id (for #links)",
      "info": "e.g. reviews → link with #reviews"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "cross",
              "label": "Cross"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "shipping",
              "label": "Truck"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "return",
              "label": "Return"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "bolt",
              "label": "Bolt"
            },
            {
              "value": "sofa",
              "label": "Couch"
            },
            {
              "value": "drop",
              "label": "Drop"
            },
            {
              "value": "hand",
              "label": "Hand"
            },
            {
              "value": "mail",
              "label": "Mail"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "box",
              "label": "Box"
            }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "30-Day Money-Back"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "VX · Trust strip",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "shield",
            "text": "30-Day Money-Back"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "shipping",
            "text": "Free Shipping"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "clock",
            "text": "Ships within 24 hours"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "lock",
            "text": "Secure Checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
