<section
  id="{% if section.settings.anchor != blank %}{{ section.settings.anchor | handleize }}{% else %}vx-{{ section.id }}{% endif %}"
  class="vx-section vx-section--track color-{{ section.settings.color_scheme }} gradient"
  style="--vx-pt: {{ section.settings.padding_top }}px; --vx-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="vx-wrap vx-wrap--narrow">
    <div class="vx-head vx-head--center">
      <h1 class="vx-h2">{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}<div class="vx-intro rte">{{ section.settings.intro }}</div>{%- endif -%}
    </div>
    <div class="vx-track__app">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
      {%- endfor -%}
      {%- if section.settings.tracking_url != blank -%}
        <form class="vx-form vx-track__form" action="{{ section.settings.tracking_url }}" method="get">
          <div class="vx-form__row">
            <div class="vx-field"><label for="VxTrack-order">{{ section.settings.label_order }}</label><input id="VxTrack-order" name="{{ section.settings.param_order }}" type="text" placeholder="#1001" required></div>
            <div class="vx-field"><label for="VxTrack-email">{{ section.settings.label_email }}</label><input id="VxTrack-email" name="{{ section.settings.param_email }}" type="email" autocomplete="email" required></div>
          </div>
          <button type="submit" class="button vx-form__submit">{{ section.settings.button }}</button>
        </form>
      {%- endif -%}
    </div>
    <div class="vx-grid vx-grid--3 vx-track__info">
      {%- for block in section.blocks -%}
        {%- if block.type == 'info' -%}
          <div class="vx-card" {{ block.shopify_attributes }}>
            <h2 class="vx-card__title">{{ block.settings.title }}</h2>
            <div class="vx-card__body rte">{{ block.settings.text }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VX · Track order",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where's my Velnoxy?"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Enter your order number and email. You'll find both in your order confirmation email.</p>"
    },
    {
      "type": "paragraph",
      "content": "Parcel Panel: either add its app block here, or keep the form below, which sends the visitor to the Parcel Panel tracking page. Check the parameter names in Parcel Panel → Tracking page settings."
    },
    {
      "type": "text",
      "id": "tracking_url",
      "label": "Tracking page URL",
      "default": "/apps/parcelpanel"
    },
    {
      "type": "text",
      "id": "param_order",
      "label": "Order number parameter",
      "default": "order"
    },
    {
      "type": "text",
      "id": "param_email",
      "label": "Email parameter",
      "default": "email"
    },
    {
      "type": "text",
      "id": "label_order",
      "label": "Order label",
      "default": "Order number"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Track my order"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id (for #links)",
      "info": "e.g. reviews → link with #reviews"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "info",
      "name": "Info card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "When does it ship?"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Text</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "VX · Track order",
      "blocks": [
        {
          "type": "info",
          "settings": {
            "title": "When does it ship?",
            "text": "<p>Orders ship within 24 hours. Delivery usually takes [X–Y] business days.</p>"
          }
        },
        {
          "type": "info",
          "settings": {
            "title": "No tracking update?",
            "text": "<p>Tracking can take 24–48 hours to show the first scan. That's normal.</p>"
          }
        },
        {
          "type": "info",
          "settings": {
            "title": "Something's wrong?",
            "text": "<p>Write to us with your order number and we'll sort it out. <a href=\"/pages/contact\">Contact support →</a></p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
