<section
  id="{% if section.settings.anchor != blank %}{{ section.settings.anchor | handleize }}{% else %}vx-{{ section.id }}{% endif %}"
  class="vx-section vx-section--contact color-{{ section.settings.color_scheme }} gradient"
  style="--vx-pt: {{ section.settings.padding_top }}px; --vx-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="vx-wrap">
    <div class="vx-contact">
      <div class="vx-contact__main">
        <h1 class="vx-h2">{{ section.settings.heading }}</h1>
        {%- if section.settings.intro != blank -%}<div class="vx-intro rte">{{ section.settings.intro }}</div>{%- endif -%}
        {%- form 'contact', id: 'VxContactForm', class: 'vx-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="vx-form__success" role="status" tabindex="-1" autofocus>
              <span class="vx-mark vx-mark--yes">{% render 'vx-icon', icon: 'check', icon_size: 14 %}</span>
              <span><strong>{{ section.settings.success_title }}</strong>{{ section.settings.success_text }}</span>
            </div>
          {%- elsif form.errors -%}
            <div class="vx-form__error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="vx-form__row">
            <div class="vx-field">
              <label for="VxContact-name">{{ section.settings.label_name }}</label>
              <input id="VxContact-name" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
            </div>
            <div class="vx-field">
              <label for="VxContact-email">{{ section.settings.label_email }} <span aria-hidden="true">*</span></label>
              <input id="VxContact-email" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
            </div>
          </div>
          <div class="vx-form__row">
            <div class="vx-field">
              <label for="VxContact-order">{{ section.settings.label_order }} <small>{{ section.settings.label_order_hint }}</small></label>
              <input id="VxContact-order" type="text" name="contact[Order number]" placeholder="#1001">
            </div>
            <div class="vx-field">
              <label for="VxContact-topic">{{ section.settings.label_topic }}</label>
              <select id="VxContact-topic" name="contact[Topic]">
                {%- assign topics = section.settings.topics | newline_to_br | split: '<br />' -%}
                {%- for t in topics -%}{%- assign tt = t | strip -%}{%- if tt != blank -%}<option>{{ tt }}</option>{%- endif -%}{%- endfor -%}
              </select>
            </div>
          </div>
          <div class="vx-field">
            <label for="VxContact-body">{{ section.settings.label_message }}</label>
            <textarea id="VxContact-body" name="contact[body]" rows="6">{{ form.body }}</textarea>
          </div>
          <button type="submit" class="button vx-form__submit">{{ section.settings.button }}</button>
        {%- endform -%}
      </div>
      <aside class="vx-contact__aside">
        <div class="vx-contact__card">
          <div class="vx-contact__line">{% render 'vx-icon', icon: 'mail' %}<span><small>{{ section.settings.email_label }}</small><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></span></div>
          <div class="vx-contact__line">{% render 'vx-icon', icon: 'clock' %}<span><small>{{ section.settings.hours_label }}</small>{{ section.settings.hours }}</span></div>
          <div class="vx-contact__line">{% render 'vx-icon', icon: 'chat' %}<span><small>{{ section.settings.reply_label }}</small>{{ section.settings.reply }}</span></div>
        </div>
        <div class="vx-contact__card">
          <p class="vx-contact__small-title">{{ section.settings.links_title }}</p>
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link }}" class="vx-contact__link" {{ block.shopify_attributes }}>{{ block.settings.label }} <span aria-hidden="true">→</span></a>
          {%- endfor -%}
        </div>
        {%- if section.settings.guarantee != blank -%}
          <div class="vx-contact__card vx-contact__card--mint">{% render 'vx-icon', icon: 'shield' %}<div class="rte">{{ section.settings.guarantee }}</div></div>
        {%- endif -%}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VX · Contact page",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Talk to a real person."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Questions about your order, your device or your routine. We read every message and answer on weekdays.</p>"
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Name label",
      "default": "Your name"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "label_order",
      "label": "Order label",
      "default": "Order number"
    },
    {
      "type": "text",
      "id": "label_order_hint",
      "label": "Order hint",
      "default": "(if you have one)"
    },
    {
      "type": "text",
      "id": "label_topic",
      "label": "Topic label",
      "default": "What's it about?"
    },
    {
      "type": "textarea",
      "id": "topics",
      "label": "Topics (one per line)",
      "default": "My order or delivery\nUsing my Velnoxy\nReturn or refund\nSomething else"
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Message label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success title",
      "default": "Got it. Thank you! "
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "We'll reply to your email within 1 business day. Check your spam folder just in case."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label (aside)",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "default": "support@velnoxy.com"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Support hours"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "Mon–Fri, 9AM–6PM EST"
    },
    {
      "type": "text",
      "id": "reply_label",
      "label": "Reply label",
      "default": "Reply time"
    },
    {
      "type": "text",
      "id": "reply",
      "label": "Reply time",
      "default": "Within 1 business day"
    },
    {
      "type": "text",
      "id": "links_title",
      "label": "Quick links title",
      "default": "Faster answers"
    },
    {
      "type": "richtext",
      "id": "guarantee",
      "label": "Guarantee note",
      "default": "<p>Every order has our <strong>30-day money-back guarantee.</strong></p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id (for #links)",
      "info": "e.g. reviews → link with #reviews"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Where's my order?"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "VX · Contact page",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "Where's my order?",
            "link": "/apps/parcelpanel"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Start a return",
            "link": "/policies/refund-policy"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "How do I use it?",
            "link": "/pages/faq"
          }
        }
      ]
    }
  ]
}
{% endschema %}
