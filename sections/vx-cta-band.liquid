<section
  id="{% if section.settings.anchor != blank %}{{ section.settings.anchor | handleize }}{% else %}vx-{{ section.id }}{% endif %}"
  class="vx-section vx-section--cta-band color-{{ section.settings.color_scheme }} gradient"
  style="--vx-pt: {{ section.settings.padding_top }}px; --vx-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="vx-wrap vx-wrap--narrow">
    <div class="vx-cta">
      {%- if section.settings.heading != blank -%}<h2 class="vx-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="vx-intro rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button vx-cta__btn">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.small != blank -%}<p class="vx-cta__small">{{ section.settings.small }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VX · CTA band",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Imagine it's July. You open the closet. And you don't do the math."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>No checking the mirror from the side. No \"maybe the long one.\" Just the outfit you actually want. It starts with 10 minutes tonight.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start My 10-Minute Ritual"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "On the product page use #offer or the product URL."
    },
    {
      "type": "text",
      "id": "small",
      "label": "Small text",
      "default": "30-day money-back guarantee · Free US shipping"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id (for #links)",
      "info": "e.g. reviews → link with #reviews"
    }
  ],
  "presets": [
    {
      "name": "VX · CTA band"
    }
  ]
}
{% endschema %}
