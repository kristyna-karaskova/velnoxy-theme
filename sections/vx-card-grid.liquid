<section
  id="{% if section.settings.anchor != blank %}{{ section.settings.anchor | handleize }}{% else %}vx-{{ section.id }}{% endif %}"
  class="vx-section vx-section--card-grid color-{{ section.settings.color_scheme }} gradient"
  style="--vx-pt: {{ section.settings.padding_top }}px; --vx-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="vx-wrap">
    {% render 'vx-heading', s: section.settings %}
    <div class="vx-grid vx-grid--{{ section.settings.columns }} vx-cards vx-cards--{{ section.settings.card_style }}">
      {%- for block in section.blocks -%}
        <div class="vx-card" {{ block.shopify_attributes }}>
          {%- case section.settings.card_style -%}
            {%- when 'cross' -%}
              <span class="vx-mark vx-mark--no">{% render 'vx-icon', icon: 'cross', icon_size: 14 %}</span>
            {%- when 'check' -%}
              <span class="vx-mark vx-mark--yes">{% render 'vx-icon', icon: 'check', icon_size: 14 %}</span>
            {%- when 'number' -%}
              <span class="vx-num">{{ forloop.index }}</span>
            {%- when 'icon' -%}
              <span class="vx-card__icon">{% render 'vx-icon', icon: block.settings.icon, icon_size: 26 %}</span>
          {%- endcase -%}
          <div class="vx-card__text">
            {%- if block.settings.title != blank -%}<h3 class="vx-card__title">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="vx-card__body rte">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.callout_text != blank or section.settings.callout_highlight != blank -%}
      <div class="vx-callout">
        {%- if section.settings.callout_text != blank -%}<div class="vx-callout__text rte">{{ section.settings.callout_text }}</div>{%- endif -%}
        {%- if section.settings.callout_highlight != blank -%}<p class="vx-callout__hl">{{ section.settings.callout_highlight }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="vx-actions vx-actions--{{ section.settings.heading_align }}">
        <a href="{{ section.settings.button_link | default: '#' }}" class="vx-link-arrow">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
