<section
  id="{% if section.settings.anchor != blank %}{{ section.settings.anchor | handleize }}{% else %}vx-{{ section.id }}{% endif %}"
  class="vx-section vx-section--offer color-{{ section.settings.color_scheme }} gradient"
  style="--vx-pt: {{ section.settings.padding_top }}px; --vx-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="vx-wrap">
    {% render 'vx-heading', s: section.settings %}
    {%- assign offer_product = section.settings.product | default: product -%}
    <div class="vx-grid vx-grid--3 vx-offer__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign v_index = block.settings.variant_position | minus: 1
          assign v = offer_product.variants[v_index]
          assign tier_index = forloop.index0
        -%}
        <div class="vx-offer__card{% if block.settings.highlight %} is-highlight{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}<span class="vx-offer__badge">{{ block.settings.badge }}</span>{%- endif -%}
          <h3 class="vx-offer__name">{{ block.settings.name }}</h3>
          {%- if v -%}
            <p class="vx-offer__price">
              <span>{{ v.price | money }}</span>
              {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
            </p>
          {%- endif -%}
          <ul class="list-unstyled vx-offer__list">
            {%- assign items = block.settings.includes | newline_to_br | split: '<br />' -%}
            {%- for it in items -%}{%- assign t = it | strip -%}{%- if t != blank -%}
              <li><span class="vx-tick is-yes">{% render 'vx-icon', icon: 'check', icon_size: 16 %}</span>{{ t }}</li>
            {%- endif -%}{%- endfor -%}
          </ul>
          <a
            href="{% if v %}{{ offer_product.url }}?variant={{ v.id }}{% else %}{{ offer_product.url }}{% endif %}"
            class="button vx-offer__btn{% unless block.settings.highlight %} button--secondary{% endunless %}"
            data-vx-tier="{{ tier_index }}"
          >
            {{ block.settings.button_label | default: 'Choose' }}
          </a>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.guarantee_title != blank -%}
      <div class="vx-guarantee">
        <div class="vx-guarantee__seal"><span>{{ section.settings.guarantee_days }}</span><small>DAYS</small></div>
        <div>
          <p class="vx-guarantee__title">{{ section.settings.guarantee_title }}</p>
          <div class="rte">{{ section.settings.guarantee_text }}</div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "VX · Offer + guarantee",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italic words are shown in teal.",
      "default": "Start your ritual tonight"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Most women start with the Essential Kit. The oil helps the nodes glide.</p>"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty on the product page to use the current product."
    },
    {
      "type": "paragraph",
      "content": "Each card links to a variant by position (1 = first variant). On the product page, \"Choose\" selects the matching Kaching bundle bar."
    },
    {
      "type": "text",
      "id": "guarantee_days",
      "label": "Guarantee days",
      "default": "30"
    },
    {
      "type": "text",
      "id": "guarantee_title",
      "label": "Guarantee title",
      "default": "Use it every night for 30 days."
    },
    {
      "type": "richtext",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "<p>If you don't love how it feels, send it back for a full refund. You're not risking $84.90. You're risking 10 minutes a night.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id (for #links)",
      "info": "e.g. reviews → link with #reviews",
      "default": "offer"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Offer",
      "settings": [
        {
          "type": "range",
          "id": "variant_position",
          "label": "Variant position",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 1
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Device Only"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight",
          "default": false
        },
        {
          "type": "textarea",
          "id": "includes",
          "label": "Includes (one per line)",
          "default": "Velnoxy™ Massager\nFree US shipping"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Choose Device Only"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "VX · Offer + guarantee",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "variant_position": 1,
            "name": "Device Only",
            "includes": "Velnoxy™ Massager\nFree US shipping",
            "button_label": "Choose Device Only"
          }
        },
        {
          "type": "tier",
          "settings": {
            "variant_position": 2,
            "name": "The Essential Kit",
            "badge": "MOST POPULAR",
            "highlight": true,
            "includes": "Velnoxy™ Massager\nFREE Premium Massage Oil\nFree US shipping",
            "button_label": "Choose The Essential Kit"
          }
        },
        {
          "type": "tier",
          "settings": {
            "variant_position": 3,
            "name": "The Full Ritual",
            "badge": "BEST VALUE",
            "includes": "Velnoxy™ Massager\nFREE Premium Massage Oil\nFREE Activation Lymphatic Brush\nFREE 14-Day Body Ritual Guide\nFree US shipping",
            "button_label": "Choose The Full Ritual"
          }
        }
      ]
    }
  ]
}
{% endschema %}
